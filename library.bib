  issn = {0011-0000},
  doi = {10.1177/0011000095233001},
  urldate = {2025-03-03},
  abstract = {Although originating from the study of infant development, attachment theory has recently been extended into domains of adult adjustment, and this emergent literature underscores the theory's promise as an integrative framework for inquiry and practice in counseling psychology. This article briefly reviews the theory's conceptual foundations and key empirical findings and traces important conceptual and methodological advances. Results of contemporary theory-guided studies of adult affect regulation, social competence, and intergenerational continuity are selectively reviewed Finally, implications of these findings for advancing an integrative understanding of healthy adult coping are considered.},
