  type = {Conference Presentation},
  title = {Video-{{Assisted Live Interviewing}} in {{Comparison}} to {{Other Survey Methods}} in {{Australia}}},
  author = {Phillips, B. and Neiger, D. and Slamowicz, C. and Lester, G. and Luddon, S. and Farrell, E. and Gerlach, K. and Carmo, P.},
