@article{silberImpactRespondentAttentiveness2019,
  title = {The Impact of Respondent Attentiveness on Reliability and Validity},
  author = {Silber, Henning and Danner, Daniel and Rammstedt, Beatrice},
  year = 2019,
  month = mar,
  journal = {International Journal of Social Research Methodology},
  volume = {22},
  number = {2},
  pages = {153--164},
  issn = {1364-5579, 1464-5300},
  doi = {10.1080/13645579.2018.1507378},
  urldate = {2023-11-21},
  abstract = {This study aims to assess whether respondent inattentiveness causes systematic and unsystematic measurement error that influences survey data quality. To determine the impact of (in)attentiveness on the reliability and validity of target measures, we compared respondents from a German online survey (N = 5205) who had passed two attention checks with those who had failed. Our results show that inattentiveness induces both random and systematic measurement error, which impacts estimates of the reliability and validity of multi-item scales. In addition, we conducted a sensitivity analysis, which revealed that the impact of inattentiveness on analyses can be substantial.},
  langid = {english},
  keywords = {inattentiveness},
  file = {files/346/Silber et al. - 2019 - The impact of respondent attentiveness on reliabil.pdf}
}

@article{simon_attachment_2019,
  title = {Attachment Styles in College Students and Depression: {{The}} Mediating Role of Self Differentiation},
  shorttitle = {Attachment Styles in College Students and Depression},
  author = {Simon, Heather L. Monaghan and DiPlacido, Joanne and Conway, James M.},
  year = 2019,
  month = mar,
  journal = {Mental Health \& Prevention},
  volume = {13},
  pages = {135--142},
  issn = {22126570},
  doi = {10.1016/j.mhp.2019.01.011},
  urldate = {2025-03-03},
  abstract = {Attachment theory has been critical in conceptualizing the development of human relationships and affect regulation. Previous research has reported relationships between insecure attachments, depressive symptoms, and self-differentiation. Insecure attachment refers to patterns of bonding that are dysfunctional in some way. Self-differentiation refers to the capacity of an individual to handle emotions and thoughts in relationships. This study explored the role of self-differentiation as a possible mediator between insecure attachment in romantic relationships and depressive symptoms among a sample of 175 college undergraduates. Participants completed the Experiences in Close Relationships Scale (ECRS), the Differentiation of Self Inventory (DSI), and the Center for Epidemiological Studies Depression Scale (CES-D). Preacher and Hayes' (2008) test for indirect effects was used to test the mediational model. As hypothesized, degree of insecure attachment predicted depressive symptoms through affect regulation. Implications of results in regards to mental health prevention among college students and future research are discussed.},
  langid = {english},
  file = {files/2702/Simon et al. - 2019 - Attachment styles in college students and depression The mediating role of self differentiation.pdf}
}

