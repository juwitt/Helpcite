@article{bianchi_web_face_face_2017,
  title = {Web-{{Face-to-Face Mixed-Mode Design}} in a {{Longitudinal Survey}}: {{Effects}} on {{Participation Rates}}, {{Sample Composition}}, and {{Costs}}},
  shorttitle = {Web-{{Face-to-Face Mixed-Mode Design}} in a {{Longitudinal Survey}}},
  author = {Bianchi, Annamaria and Biffignandi, Silvia and Lynn, Peter},
  year = 2017,
  month = jun,
  journal = {Journal of Official Statistics},
  volume = {33},
  number = {2},
  pages = {385--408},
  issn = {2001-7367},
  doi = {10.1515/jos-2017-0019},
  urldate = {2024-07-29},
  abstract = {Abstract             Sequential mixed-mode designs are increasingly considered as an alternative to interviewer-administered data collection, allowing researchers to take advantage of the benefits of each mode. We assess the effects of the introduction of a sequential web-face-to-face mixed-mode design over three waves of a longitudinal survey in which members were previously interviewed face-to-face. Findings are reported from a large-scale randomised experiment carried out on the UK Household Longitudinal Study. No differences are found between the mixed-mode design and face-to-face design in terms of cumulative response rates and only minimal differences in terms of sample composition. On the other hand, potential cost savings are evident.},
  copyright = {http://creativecommons.org/licenses/by-nc-nd/3.0},
  langid = {english},
  file = {files/2013/Bianchi et al. - 2017 - Web-Face-to-Face Mixed-Mode Design in a Longitudin.pdf}
}

