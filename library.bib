@article{teichlerEntkoppelteLebensweltenSoziale2023,
  title = {{Entkoppelte Lebenswelten? Soziale Beziehungen und gesellschaftlicher Zusammenhalt in Deutschland - Erster Zusammenhaltsbericht des FGZ}},
  shorttitle = {{Entkoppelte Lebenswelten?}},
  author = {Teichler, Nils and Gerlitz, Jean-Yves and Cornesse, Carina and Dilger, Clara and {Groh-Samberg}, Olaf and Lengfeld, Holger and Nissen, Eric and Reinecke, Jost and Skolarski, Stephan and Traunm{\"u}ller, Richard and {Verneuer-Emre}, Lena M.},
