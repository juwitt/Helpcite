# Get a free key at https://console.groq.com/keys (no payment details needed).
GROQ_API_KEY=gsk_replace_me_with_your_key

# Absolute path to your Zotero "storage" folder (the one containing many
# subfolders with random 8-character names, e.g. "Zotero/storage/3XK9QP7T").
# Windows example:  ZOTERO_PDF_DIR=C:/Users/you/Zotero/storage
# macOS example:    ZOTERO_PDF_DIR=/Users/you/Zotero/storage
# Linux example:    ZOTERO_PDF_DIR=/home/you/Zotero/storage
ZOTERO_PDF_DIR=

# Optional: override the BibTeX export file or the database folder.
# BIBTEX_PATH=/absolute/path/to/library.bib
# CHROMA_DIR=/absolute/path/to/chroma_db
